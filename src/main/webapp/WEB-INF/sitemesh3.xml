<?xml version="1.0" encoding="UTF-8"?>
<sitemesh>
    <!-- Authentication layout in /WEB-INF/decorators/ -->
    <mapping path="/login" decorator="auth.jsp"/>
    <mapping path="/register" decorator="auth.jsp"/>
    <mapping path="/forgot-password" decorator="auth.jsp"/>
    <mapping path="/verify-otp" decorator="auth.jsp"/>
    <mapping path="/reset-password" decorator="auth.jsp"/>
    <mapping path="/views/login.jsp" decorator="auth.jsp"/>
    <mapping path="/views/register.jsp" decorator="auth.jsp"/>
    <mapping path="/views/forgot-password.jsp" decorator="auth.jsp"/>
    <mapping path="/views/verify-otp.jsp" decorator="auth.jsp"/>
    <mapping path="/views/reset-password.jsp" decorator="auth.jsp"/>

    <!-- Main web layout in /WEB-INF/decorators/ -->
    <mapping path="/" decorator="web.jsp"/>
    <mapping path="/home" decorator="web.jsp"/>
    <mapping path="/profile" decorator="web.jsp"/>
    <mapping path="/category" decorator="web.jsp"/>
    <mapping path="/category/*" decorator="web.jsp"/>
    <mapping path="/product" decorator="web.jsp"/>
    <mapping path="/product/*" decorator="web.jsp"/>
    <mapping path="/error" decorator="web.jsp"/>
    <mapping path="/views/*" decorator="web.jsp"/>
    <mapping path="/*" decorator="web.jsp"/>

    <!-- Exclude static resources -->
    <mapping path="/css/*" exclude="true"/>
    <mapping path="/js/*" exclude="true"/>
    <mapping path="/images/*" exclude="true"/>
    <mapping path="/uploads/*" exclude="true"/>
    <mapping path="/assets/*" exclude="true"/>
    <mapping path="/WEB-INF/*" exclude="true"/>
</sitemesh>
